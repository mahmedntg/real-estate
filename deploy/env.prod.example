# Copy to deploy/.env.prod and fill in. Never commit the filled file.
# Caddy terminates TLS for this hostname (DuckDNS name pointing at the server IP).
SITE_ADDRESS=aqar-demo.duckdns.org

# Database (the compose file creates the user and database)
AQAR_DB_PASSWORD=replace-with-a-long-random-password

# API
AQAR_JWT_SECRET=replace-with-48-plus-random-characters
AQAR_SEED=false
AQAR_EXPOSE_VERIFICATION_CODE=false
AQAR_SWAGGER_ENABLED=false
AQAR_CORS_ORIGINS=https://aqar-demo.duckdns.org

# S3-compatible media storage; leave the bucket empty to fall back to server disk
AQAR_S3_BUCKET=
AQAR_S3_REGION=auto
AQAR_S3_ENDPOINT=
AQAR_S3_PUBLIC_URL=
AQAR_S3_ACCESS_KEY=
AQAR_S3_SECRET_KEY=

# WhatsApp Cloud API verification codes, with SMTP as the fallback
AQAR_WHATSAPP_TOKEN=
AQAR_WHATSAPP_PHONE_ID=
AQAR_WHATSAPP_TEMPLATE=aqar_verification_code
AQAR_WHATSAPP_TEMPLATE_LANG=ar
AQAR_SMTP_HOST=smtp.gmail.com
AQAR_SMTP_PORT=587
AQAR_SMTP_USERNAME=
AQAR_SMTP_PASSWORD=
AQAR_MAIL_FROM=
